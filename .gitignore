# dependencies
**/node_modules/
**/.pnp/
**/.pnp.*
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/versions/

# builds and framework output
**/.next/
**/out/
**/build/
**/dist/
**/coverage/
frontend2/.next.zip

# environment files
**/.env
**/.env.*
!**/.env.example

# logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/.next-dev.log
**/.next-dev.err

# local tooling
**/.vercel/
**/*.tsbuildinfo
**/next-env.d.ts
.tmp-video-frames/

# OS and editor files
.DS_Store
Thumbs.db
*.pem

# nested git metadata backups kept while converting to one root repo
**/.git-*-backup/

# runtime uploads: keep folder placeholders, ignore uploaded files
backend/public/uploads/**
!backend/public/uploads/**/
!backend/public/uploads/**/.gitkeep

# deployment packages and generated local artifacts
deploy/
admin/out-cpanel/
frontend2/android-cap8-backup-*/
*.apk
*.zip
*-check.png
# Android release signing secrets
*.jks
*.keystore
**/keystore.properties
.tmp/